<Window x:Class="Terminal_SCP.AddAnomalyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация объекта"
        Height="600" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Accent}" Height="4" VerticalAlignment="Top"/>
        
        <StackPanel Grid.Row="0" Margin="28,18,28,14">
            <TextBlock Text="РЕГИСТРАЦИЯ ОБЪЕКТА"
                       Style="{StaticResource StampedHeader}"/>
            <TextBlock Text="ЗАПОЛНИТЕ КАРТОЧКУ АНОМАЛИИ // УРОВЕНЬ 4"
                       Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="28,0">
            <StackPanel>
                <TextBlock Text="КОД / НАЗВАНИЕ" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource TerminalTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="КЛАСС ОБЪЕКТА" Style="{StaticResource SectionLabel}"/>
                <ComboBox Style="{StaticResource TerminalCombo}" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Safe"/>
                    <ComboBoxItem Content="Euclid"/>
                    <ComboBoxItem Content="Keter"/>
                    <ComboBoxItem Content="Бюро"/>
                </ComboBox>

                <TextBlock Text="УРОВЕНЬ УГРОЗЫ (1–5)" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource TerminalTextBox}" Margin="0,0,0,12"/>

                <TextBlock Text="СТАТУС ИЗОЛЯЦИИ" Style="{StaticResource SectionLabel}"/>
                <ComboBox Style="{StaticResource TerminalCombo}" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Изолирован"/>
                    <ComboBoxItem Content="Наблюдение"/>
                    <ComboBoxItem Content="Утерян"/>
                </ComboBox>

                <TextBlock Text="ДАТА УЧЁТА" Style="{StaticResource SectionLabel}"/>
                <DatePicker Margin="0,0,0,12" Height="36"/>

                <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource TerminalTextBox}" Height="80"
                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12"/>

                <TextBlock Text="СЕКРЕТНОЕ РАСПОЛОЖЕНИЕ" Style="{StaticResource SectionLabel}"/>
                <TextBox Style="{StaticResource TerminalTextBox}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                Padding="28,14" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ОТМЕНА" Style="{StaticResource DangerButton}"
                        Padding="16,8" FontSize="12" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="СОХРАНИТЬ" Style="{StaticResource TerminalButton}"
                        Padding="16,8" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>