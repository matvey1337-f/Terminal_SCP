<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgDark"      Color="#0A0A0A"/>
    <SolidColorBrush x:Key="BgPanel"     Color="#141414"/>
    <SolidColorBrush x:Key="BgCard"      Color="#161616"/>
    <SolidColorBrush x:Key="Accent"      Color="#C0392B"/>
    <SolidColorBrush x:Key="Warning"     Color="#E67E22"/>
    <SolidColorBrush x:Key="TextBrush"   Color="#E6E6E6"/>
    <SolidColorBrush x:Key="Muted"       Color="#7F8C8D"/>
    <SolidColorBrush x:Key="Divider"     Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SafeBrush"   Color="#27AE60"/>
    <SolidColorBrush x:Key="EuclidBrush" Color="#F1C40F"/>
    <SolidColorBrush x:Key="KeterBrush"  Color="#E74C3C"/>
    <SolidColorBrush x:Key="BureauBrush" Color="#3498DB"/>

    <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0A0A0A" Offset="0"/>
        <GradientStop Color="#141414" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="TerminalHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="StampedHeader" TargetType="TextBlock" BasedOn="{StaticResource TerminalHeader}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>

    <Style x:Key="ClassifiedStamp" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Text" Value="КЛАССИФИЦИРОВАНО // УРОВЕНЬ 4"/>
    </Style>

    <Style x:Key="TerminalTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0F0F0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#2E2E2E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#0F0F0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#2E2E2E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}"
                            BorderBrush="#000" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource TerminalButton}">
        <Setter Property="Background" Value="#4A1410"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="TerminalCombo" TargetType="ComboBox">
        <Setter Property="Background" Value="#0F0F0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#2E2E2E"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" 
                                      Focusable="False" 
                                      ClickMode="Press"
                                      Background="#0F0F0F"
                                      BorderBrush="#2E2E2E"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border" 
                                            Background="#0F0F0F" 
                                            BorderBrush="#2E2E2E" 
                                            BorderThickness="1" 
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" 
                                                  Fill="{StaticResource Accent}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="10,0,0,0" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Left"
                                          TextElement.Foreground="{StaticResource TextBrush}"/>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" 
                               IsOpen="{TemplateBinding IsDropDownOpen}" 
                               Placement="Bottom" PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder" 
                                    Background="#0F0F0F" 
                                    BorderBrush="{StaticResource Accent}" 
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" 
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TerminalComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#0F0F0F"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AnomalyCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="AnomalyTemplate">
        <Border Style="{StaticResource AnomalyCard}">
            <Grid>
                <Border Width="5" HorizontalAlignment="Left" CornerRadius="3,0,0,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Safe">
                                    <Setter Property="Background" Value="{StaticResource SafeBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Euclid">
                                    <Setter Property="Background" Value="{StaticResource EuclidBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Keter">
                                    <Setter Property="Background" Value="{StaticResource KeterBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Бюро">
                                    <Setter Property="Background" Value="{StaticResource BureauBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Margin="18,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                        <TextBlock Text="{Binding Title}" FontFamily="Consolas"
                                   FontWeight="Bold" FontSize="16"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="2"
                                VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#000">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Safe">
                                            <Setter Property="Background" Value="#1E5A33"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Euclid">
                                            <Setter Property="Background" Value="#5A4B14"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Keter">
                                            <Setter Property="Background" Value="#5A1A14"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Бюро">
                                            <Setter Property="Background" Value="#163F5A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Category}" FontFamily="Consolas"
                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,7,0,0">
                        <TextBlock Text="УГРОЗА: " Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ThreatStars}"
                                   Foreground="{StaticResource Accent}"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="  │  СТАТУС: " Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ContainmentStatus}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="  │  " Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                   Style="{StaticResource MutedText}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Description}" Grid.Row="2"
                               TextWrapping="Wrap" MaxHeight="36"
                               Foreground="{StaticResource Muted}" FontSize="12"
                               Margin="0,7,0,0"/>

                    <Border x:Name="SecretRow" Grid.Row="3" Margin="0,8,0,0"
                            Background="#0E2433" BorderBrush="{StaticResource BureauBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="8,4"
                            Visibility="Collapsed">
                        <TextBlock Text="{Binding SecretLocation, StringFormat=▸ РАСПОЛОЖЕНИЕ: {0}}"
                                   Foreground="{StaticResource BureauBrush}"
                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>