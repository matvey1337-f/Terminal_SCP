<Window x:Class="Terminal_SCP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фонд SCP — Каталог аномалий"
        Height="740" Width="1120"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        Background="{StaticResource WindowBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Accent}" Height="4"/>

        <Grid Grid.Row="1" Margin="24,16,24,0">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource Accent}" Width="4" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="КАТАЛОГ АНОМАЛИЙ И АРТЕФАКТОВ"
                               Style="{StaticResource StampedHeader}"/>
                    <TextBlock x:Name="lblAgent" Style="{StaticResource MutedText}"
                               Text="АГЕНТ: — │ ДОПУСК: —" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource ClassifiedStamp}" VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button x:Name="btnLogout" Content="ВЫХОД"
                        Style="{StaticResource DangerButton}"
                        Padding="12,6" FontSize="12" Click="btnLogout_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1"
                Margin="24,14,24,0" VerticalAlignment="Bottom"/>

        <Grid Grid.Row="2" Margin="24,16,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="cmbCategory" Grid.Column="0" Style="{StaticResource TerminalCombo}"
                      ItemContainerStyle="{StaticResource TerminalComboBoxItem}"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="Все классы" IsSelected="True"/>
                <ComboBoxItem Content="Safe"/>
                <ComboBoxItem Content="Euclid"/>
                <ComboBoxItem Content="Keter"/>
                <ComboBoxItem Content="Бюро"/>
            </ComboBox>

            <ComboBox x:Name="cmbStatus" Grid.Column="1" Style="{StaticResource TerminalCombo}"
                      ItemContainerStyle="{StaticResource TerminalComboBoxItem}"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                <ComboBoxItem Content="Изолирован"/>
                <ComboBoxItem Content="Наблюдение"/>
                <ComboBoxItem Content="Утерян"/>
            </ComboBox>

            <Grid Grid.Column="2" Margin="0,0,8,0">
                <TextBox x:Name="txtSearch" Style="{StaticResource TerminalTextBox}"/>
                <TextBlock Text="ПОИСК ПО КОДУ ОБЪЕКТА..."
                           Foreground="#4A4A4A" FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="3" Content="СБРОС" Style="{StaticResource TerminalButton}"
                    Margin="0,0,8,0" Padding="12,6" FontSize="12"/>

            <Button x:Name="btnAdd" Grid.Column="4" Content="+ ДОБАВИТЬ"
                    Style="{StaticResource TerminalButton}"
                    Margin="0,0,8,0" Padding="12,6" FontSize="12"
                    Visibility="Collapsed" Click="btnAdd_Click"/>

            <Button x:Name="btnDelete" Grid.Column="5" Content="УДАЛИТЬ"
                    Style="{StaticResource DangerButton}"
                    Padding="12,6" FontSize="12"
                    Visibility="Collapsed"/>
        </Grid>

        <ListView x:Name="lvAnomalies" Grid.Row="3" Margin="24,0,24,0"
                  ItemTemplate="{StaticResource AnomalyTemplate}"
                  Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border Grid.Row="4" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                Padding="24,8" Margin="0,14,0,0">
            <Grid>
                <TextBlock Text="ФОНД SCP // ВНУТРЕННЯЯ СЕТЬ // СЕССИЯ ЗАЩИЩЕНА"
                           Style="{StaticResource MutedText}"/>
                <TextBlock x:Name="lblCount" Text="ОБЪЕКТОВ: —"
                           Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>